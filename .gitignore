################################################################################
# Visual Studio Git Ignore
################################################################################

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
*/bin/
*/obj/
*/out/
*/Debug/
*/Release/

# Visual Studio folder
/.vs/

# Other generated files
*.cache
*.log
*.dll
*.exe
*.pdb
*.tmp
*.ide
*.dbmdl

# Auto-generated packages
packages/
*.nuget.props
*.nuget.targets

# Others
*.localhistory/
